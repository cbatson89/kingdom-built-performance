# ─────────────────────────────────────────────────────────────────────────
# Kingdom Built Performance — environment variables
# Copy this file to `.env.local` and fill in real values.
# `.env.local` is gitignored and never committed.
# ─────────────────────────────────────────────────────────────────────────

# --- Contact form (Resend) ---------------------------------------------------
# The contact form is fully wired but INERT until these are set.
# Create an account + API key at https://resend.com
# Until a real key is present, /api/contact returns a clear "not configured"
# error and the UI shows an error state (nothing is sent).
RESEND_API_KEY=
# Where contact-form submissions are emailed to (e.g. info@kingdombuiltperformance.com).
CONTACT_FORM_TO_EMAIL=
# The "from" address Resend sends as. Must be a domain you've verified in Resend.
# Defaults to onboarding@resend.dev (Resend's test sender) if left blank.
CONTACT_FORM_FROM_EMAIL=

# --- Analytics (Google Analytics 4) -----------------------------------------
# Optional. GA is a no-op until a real measurement ID is provided.
# Format: G-XXXXXXXXXX
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# --- Site ---------------------------------------------------------------------
# Canonical/base URL used for metadata, sitemap, robots, and OG tags.
# Defaults to https://kingdombuiltperformance.com if unset.
NEXT_PUBLIC_SITE_URL=https://kingdombuiltperformance.com
